{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lease",
  "version": "0.0.3",
  "identifier": "jikkal.app.lease",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "lease",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaW5pIHB1YmxpYyBrZXk6IDQ5N0I3QjY1OTdBMkM2M0EKUldRNnhxS1haWHQ3U1pYa0dNTEVObWtBUEd6TlJXY09iT1EwRlRQbi9YZ1Bic3lCMnVkMzNUU1UK",
      "endpoints": [
        "https://github.com/IsraelJP/lease/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
